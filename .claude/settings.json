{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/issue-todo-reminder.sh",
            "if": "Bash(git commit*)"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(gh release create:*)",
      "Bash(gh issue create:*)",
      "Bash(gh pr create:*)"
    ]
  }
}
